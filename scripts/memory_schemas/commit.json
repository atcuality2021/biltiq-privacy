{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "commit",
  "description": "A git commit was made in the repo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_type", "ts", "hash", "msg"],
  "properties": {
    "schema":     {"const": "v1"},
    "event_type": {"const": "commit"},
    "ts":         {"type": "string", "format": "date-time"},
    "hash":       {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "msg":        {"type": "string", "maxLength": 500},
    "files":      {"type": "array", "items": {"type": "string"}, "maxItems": 50},
    "author":     {"type": "string", "maxLength": 200},
    "branch":     {"type": "string", "maxLength": 200}
  }
}
