{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "eod_post",
  "description": "End-of-day post (auto-fired at 17:30 IST or manually via /biltiq-engineering:eod).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_type", "ts"],
  "properties": {
    "schema":     {"const": "v1"},
    "event_type": {"const": "eod_post"},
    "ts":         {"type": "string", "format": "date-time"},
    "shipped":    {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^(BILTIQ-[0-9a-z]+|M[0-9]+[a-z]?)$"},
          "pr":      {"type": "string", "pattern": "^#?[0-9]+$"},
          "title":   {"type": "string", "maxLength": 200}
        }
      },
      "maxItems": 20
    },
    "wip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id":     {"type": "string"},
        "branch":      {"type": "string"},
        "percent_done":{"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "tomorrow":   {"type": "string", "maxLength": 200},
    "tech_debt":  {"type": "string", "maxLength": 500},
    "trigger":    {"enum": ["auto", "manual"]}
  }
}
